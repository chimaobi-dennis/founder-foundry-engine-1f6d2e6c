# Frontend settings. Copy to .env (which is git-ignored) and fill in your own values.
#
# Only PUBLIC values belong here. Every VITE_ variable is inlined into the browser
# bundle and readable by every visitor. NEVER put a Supabase service_role key,
# a Stripe secret key or any AI provider key in this file.
#
# NOTE: src/config/supabaseConfig.ts currently takes precedence over these values.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
